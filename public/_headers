# Cloudflare Pages HTTP headers — security hardening for Suss.
# No user data is stored anywhere; these headers reduce client-side attack surface.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' wss://*.partykit.dev https://*.partykit.dev ws://127.0.0.1:1999 ws://localhost:1999 http://127.0.0.1:1999 http://localhost:1999; manifest-src 'self'; worker-src 'self'; font-src 'self'; media-src 'self'

# Service worker must be served from root scope with no long-term cache.
/sw.js
  Cache-Control: no-cache
